# Base de datos local. No uses estas credenciales en producción.
SEATFORGE_DATABASE_NAME=seatforge
SEATFORGE_DATABASE_USERNAME=seatforge
SEATFORGE_DATABASE_PASSWORD=seatforge
SEATFORGE_DATABASE_PORT=5432

# Spring usa una URL JDBC completa.
SEATFORGE_DATABASE_URL=jdbc:postgresql://localhost:5432/seatforge
AUTH0_AUDIENCE=https://api.seatforge.localb
AUTH0_ISSUER=https://tenant.us.auth0.com/