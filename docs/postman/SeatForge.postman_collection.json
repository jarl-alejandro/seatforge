  "item": [
    {
      "name": "00 - Auth0 tokens",
      "description": "Configura los Client ID/Secret de cada aplicación M2M. Los scripts guardan automáticamente los access_token sin imprimir secretos.",
      "item": [
        {
          "name": "Obtener token ORGANIZER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{auth0TokenUrl}}"
            },
            "description": "Solicita un token M2M con permisos de organizador.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{organizerClientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{organizerClientSecret}}",
                  "type": "text"
                },
                {
                  "key": "audience",
                  "value": "{{auth0Audience}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "create:events publish:events",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Auth0 responde 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('organizerToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener token BUYER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{auth0TokenUrl}}"
            },
            "description": "Solicita un token M2M con permisos de comprador.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{buyerClientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{buyerClientSecret}}",
                  "type": "text"
                },
                {
                  "key": "audience",
                  "value": "{{auth0Audience}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "reserve:tickets create:orders read:orders pay:orders",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Auth0 responde 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('buyerToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
