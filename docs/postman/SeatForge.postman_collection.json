    {
      "name": "01 - US-003 Crear evento",
      "item": [
        {
          "name": "Crear evento válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": "US-003 implementada. Crea el evento DRAFT y exactamente capacity entradas AVAILABLE en una transacción.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{organizerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SeatForge Concert\",\n  \"startsAt\": \"{{eventStartsAt}}\",\n  \"price\": {\n    \"amount\": 25.0,\n    \"currency\": \"USD\"\n  },\n  \"capacity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Evento creado', () => pm.response.to.have.status(201));",
                  "pm.test('Respuesta DRAFT', () => { if (pm.response.code === 201) pm.expect(pm.response.json().status).to.eql('DRAFT'); });",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('eventId', pm.response.json().eventId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
